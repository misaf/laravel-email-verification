{
    "name": "misaf/laravel-email-validation-emailable",
    "description": "Emailable deliverability driver for Laravel email validation",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "misaf",
        "email",
        "validation",
        "emailable"
    ],
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/misaf/laravel-email-validation-emailable",
    "support": {
        "issues": "https://github.com/misaf/laravel-email-validation-emailable/issues",
        "source": "https://github.com/misaf/laravel-email-validation-emailable"
    },
    "require": {
        "php": "^8.4",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "misaf/laravel-email-validation": "^1.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Misaf\\LaravelEmailValidationEmailable\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\LaravelEmailValidationEmailable\\Providers\\EmailableServiceProvider"
            ]
        }
    },
    "$schema": "https://getcomposer.org/schema.json"
}
