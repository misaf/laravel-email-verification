parameters:

    paths:
        - src

    # Driver package tests live inside src/ by monorepo layout; the analysed
    # surface is production code only, matching each driver package's own
    # phpstan.neon.
    excludePaths:
        - src/Drivers/laravel-email-verification-bouncer/tests
        - src/Drivers/laravel-email-verification-emailable/tests

    # Each driver package ships its own config file; without this, larastan
    # only recognises the root config/ directory and flags their env() calls.
    configDirectories:
        - config
        - src/Drivers/*/config

    # Level 10 is the highest level
    level: 10
#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php
#
#    checkMissingIterableValueType: false
