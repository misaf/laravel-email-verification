{
    "name": "misaf/laravel-email-validation",
    "description": "Provider-neutral email domain and deliverability validation for Laravel applications",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "misaf",
        "email",
        "validation",
        "deliverability"
    ],
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/misaf/laravel-email-validation",
    "support": {
        "issues": "https://github.com/misaf/laravel-email-validation/issues",
        "source": "https://github.com/misaf/laravel-email-validation"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-package-tools": "^1.93",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.5",
        "laravel/pint": "^1.3",
        "mockery/mockery": "^1.6",
        "monorepo-php/monorepo": "^12.7",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-profanity": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "suggest": {
        "misaf/laravel-email-validation-bouncer": "Adds the \"bouncer\" deliverability driver, backed by the Bouncer API (https://usebouncer.com)",
        "misaf/laravel-email-validation-emailable": "Adds the \"emailable\" deliverability driver, backed by the Emailable API (https://emailable.com)"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Misaf\\LaravelEmailValidation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\LaravelEmailValidation\\Tests\\": "tests/",
            "Misaf\\LaravelEmailValidationBouncer\\": "src/Verifiers/laravel-email-validation-bouncer/src/",
            "Misaf\\LaravelEmailValidationEmailable\\": "src/Verifiers/laravel-email-validation-emailable/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\LaravelEmailValidation\\Providers\\EmailValidationServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "$schema": "https://getcomposer.org/schema.json"
}
